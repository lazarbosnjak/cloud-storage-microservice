########### User service ###########
GRPC_PORT=50052
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

########### MONGO ###########
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_HOST=mongo-user-service
MONGO_PORT=27017
MONGO_DB=users_db

MONGO_PING_TIMEOUT_SECONDS=10
MONGO_DISCONNECT_TIMEOUT_SECONDS=10

########### MongoDB Healthcheck ###########

MONGO_HEALTH_INTERVAL=10s
MONGO_HEALTH_TIMEOUT=10s
MONGO_HEALTH_RETRIES=10
