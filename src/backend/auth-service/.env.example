########### Auth service ###########
GRPC_PORT=50057
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

ADMIN_EMAIL=admin@pouch.com  # <- Dummy info, change this!
ADMIN_PASSWORD=admin123      # <- Dummy info, change this!

########### POSTGRES ###########
POSTGRES_USER=auth_admin  # <- Dummy info, change this!
POSTGRES_PASSWORD=pass    # <- Dummy info, change this!
POSTGRES_DB=auth_db       # <- Dummy info, change this!
POSTGRES_HOST=postgres-auth-service
POSTGRES_PORT=5432

########### CONNECTION POOLING ###########
MAX_CONNECTIONS=10
MIN_CONNECTIONS=2
MAX_CONNECTION_LIFETIME_IN_MINUTES=60
MAX_CONNECTION_IDLE_TIME_IN_MINUTES=30
HEALTH_CHECK_PERIOD_IN_SECONDS=60
PING_TIMEOUT_SECONDS=20

########### CREDENTIAL POLICY ###########
CREDENTIAL_MAX_EMAIL_LENGTH=254
CREDENTIAL_MIN_PASSWORD_LENGTH=8
CREDENTIAL_MAX_PASSWORD_LENGTH=128
CREDENTIAL_MAX_PASSWORD_AGE=2160h

########### ARGON2ID PARAMS ###########
ARGON2ID_MEMORY_KIBIBYTES=128
ARGON2ID_ITERATIONS=4
ARGON2ID_PARALLELISM=1
ARGON2ID_SALT_LENGTH=16
ARGON2ID_KEY_LENGTH=32

########### TOKEN PARAMS ###########
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private_key
JWT_KEY_ID=dev-1
JWT_ISSUER=auth-service
JWT_AUDIENCE=pouch
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_IDLE_TTL=168h
REFRESH_TOKEN_ABSOLUTE_TTL=720h
REFRESH_REUSE_GRACE=10s
LOCKOUT_TRESHOLD=5
LOCKOUT_BASE_DURATION=1m
LOCKOUT_MAX_DURATION=15m
LOCKOUT_RESET_WINDOW=15m