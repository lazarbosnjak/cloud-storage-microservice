
########### File service ###########

GRPC_PORT=50053
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
PING_DELAY_SECONDS=5

########### MongoDB ###########

MONGO_INITDB_ROOT_USERNAME=file_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_HOST=mongo-file-service
MONGO_PORT=27017
MONGO_DB=files_db

MONGO_PING_TIMEOUT_SECONDS=10
MONGO_DISCONNECT_TIMEOUT_SECONDS=10

########### MongoDB Healthcheck ###########

MONGO_HEALTH_INTERVAL=10s
MONGO_HEALTH_TIMEOUT=10s
MONGO_HEALTH_RETRIES=10

########### User service ###########

USER_SERVICE_ADDRESS=user-service:50052
USER_SERVICE_TIMEOUT_SECONDS=5