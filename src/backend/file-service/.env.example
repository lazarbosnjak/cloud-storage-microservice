########### File service ###########

GRPC_PORT=50053
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30

MONGO_INITDB_ROOT_USERNAME=file_admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
MONGO_HOST=mongo-file-service
MONGO_PORT=27017
MONGO_DB=files_db

########### MongoDB Healthcheck ###########

MONGO_HEALTH_INTERVAL=10s
MONGO_HEALTH_TIMEOUT=10s
MONGO_HEALTH_RETRIES=10
