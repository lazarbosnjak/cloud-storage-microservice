########### API Gateway ###########

GRPC_PORT=8080
REST_PORT=8090
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public_key

USER_SERVICE_GRPC_ADDR="user-service:50052"
AUTH_SERVICE_GRPC_ADDR="auth-service:50057"
FILE_SERVICE_GRPC_ADDR="file-service:50053"
NOTIFICATION_SERVICE_GRPC_ADDR="notification-service:50055"

########### Rate limit ###########
RATE_LIMIT_RPS=1
RATE_LIMIT_BUCKET_SIZE=5
RATE_LIMIT_IDLE_TTL=5m
